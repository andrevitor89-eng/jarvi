{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ],
      "@/screens/*": [
        "src/screens/*"
      ],
      "@/components/*": [
        "src/components/*"
      ],
      "@/services/*": [
        "src/services/*"
      ],
      "@/types/*": [
        "../shared/src/types/*"
      ],
      "@/utils/*": [
        "../shared/src/utils/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "nativewind-env.d.ts"
  ],
  "exclude": [
    "node_modules",
    "src/components/ui",
    "src/components/design-system",
    "src/screens/DesignSystemTestScreen.tsx",
    "src/config/fonts.ts",
    "src/config/nativewind.ts"
  ]
}